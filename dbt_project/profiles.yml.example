# dbt profile for the Snowflake pipeline.
# Auth: password from .env (SNOWFLAKE_ACCOUNT / SNOWFLAKE_USER / SNOWFLAKE_PASSWORD).
# Copy to ~/.dbt/profiles.yml (never commit a filled-in copy).
# Added 2026-11-14
#
# Schema: both models land here. Neither model SQL, schema.yml, nor
# dbt_project.yml sets a per-model schema, so silver and gold share the
# profile schema. The gold table the Streamlit app reads is RAW_BRONZE.pacing_obt.
sports_analytics:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: <SNOWFLAKE_ACCOUNT>
      user: <SNOWFLAKE_USER>
      password: <SNOWFLAKE_PASSWORD>
      role: ACCOUNTADMIN
      database: SPORTS_ANALYTICS_DB
      warehouse: COMPUTE_WH
      schema: RAW_BRONZE
      threads: 4
